<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>[prompt-butler] %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="prompt-butler" level="INFO" additivity="false">
        <appender-ref ref="STDERR" />
    </logger>

    <root level="WARN">
        <appender-ref ref="STDERR" />
    </root>
</configuration>
